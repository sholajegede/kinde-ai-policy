{
  "name": "kinde-ai-policy",
  "version": "0.4.0",
  "description": "Decide which AI models, output limits and budgets each Kinde user, organization or agent gets, from their Kinde plan and billing entitlements, and hand the decision to your AI gateway. Reserves budget before the call and settles it after.",
  "type": "module",
  "license": "MIT",
  "author": "Shola Jegede",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sholajegede/kinde-ai-policy.git"
  },
  "homepage": "https://github.com/sholajegede/kinde-ai-policy#readme",
  "bugs": "https://github.com/sholajegede/kinde-ai-policy/issues",
  "keywords": [
    "kinde",
    "ai",
    "llm",
    "ai-gateway",
    "budgets",
    "spend-limits",
    "rate-limiting",
    "billing",
    "entitlements",
    "authorization",
    "saas",
    "ai-agents",
    "m2m",
    "openai",
    "openrouter",
    "litellm",
    "vercel-ai-gateway",
    "ai-sdk",
    "portkey"
  ],
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./openai-compatible": {
      "import": {
        "types": "./dist/openai-compatible.d.ts",
        "default": "./dist/openai-compatible.js"
      },
      "require": {
        "types": "./dist/openai-compatible.d.cts",
        "default": "./dist/openai-compatible.cjs"
      }
    },
    "./openrouter": {
      "import": {
        "types": "./dist/openrouter.d.ts",
        "default": "./dist/openrouter.js"
      },
      "require": {
        "types": "./dist/openrouter.d.cts",
        "default": "./dist/openrouter.cjs"
      }
    },
    "./vercel": {
      "import": {
        "types": "./dist/vercel.d.ts",
        "default": "./dist/vercel.js"
      },
      "require": {
        "types": "./dist/vercel.d.cts",
        "default": "./dist/vercel.cjs"
      }
    },
    "./ai-sdk": {
      "import": {
        "types": "./dist/ai-sdk.d.ts",
        "default": "./dist/ai-sdk.js"
      },
      "require": {
        "types": "./dist/ai-sdk.d.cts",
        "default": "./dist/ai-sdk.cjs"
      }
    },
    "./litellm": {
      "import": {
        "types": "./dist/litellm.d.ts",
        "default": "./dist/litellm.js"
      },
      "require": {
        "types": "./dist/litellm.d.cts",
        "default": "./dist/litellm.cjs"
      }
    },
    "./portkey": {
      "import": {
        "types": "./dist/portkey.d.ts",
        "default": "./dist/portkey.js"
      },
      "require": {
        "types": "./dist/portkey.d.cts",
        "default": "./dist/portkey.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude 'test/contract/**' --exclude 'test/live/**' --exclude 'test/local/**'",
    "test:contract": "vitest run test/contract",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "test:live": "vitest run test/live",
    "test:gateways": "vitest run test/local"
  },
  "dependencies": {
    "jose": "^6.2.17"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "kinde-testkit": "^0.8.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^5.1.1",
    "ai": "^7.0.181",
    "@portkey-ai/gateway": "^1.15.2"
  },
  "peerDependencies": {
    "ai": ">=6"
  },
  "peerDependenciesMeta": {
    "ai": {
      "optional": true
    }
  }
}
